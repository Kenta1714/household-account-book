# 開発環境用。APP_ENVは起動コマンドでdevelopmentを指定する。
# openssl rand -hex 32 で生成した値を設定（Renderとは別の値）。
FLASK_SECRET_KEY=
APP_USERNAME=
APP_PASSWORD=
# 既存のSQLiteを引き続き使用する。別のDBパスへ変更しないこと。
DATABASE_URL=sqlite:///household.db
GMAIL_REDIRECT_URI=http://localhost:8080/gmail/oauth/callback
CREDENTIALS_FILE=credentials.json
# OAUTHLIB_INSECURE_TRANSPORTは開発localhostに限りアプリが設定する。
